# Public production site origin, used for canonical URLs and Open Graph URLs.
# Example: https://www.example.com
VITE_SITE_URL=

# Optional production quote/enquiry endpoint.
# The endpoint should accept multipart/form-data POST requests and return a 2xx response.
# If left empty, the quote form falls back to opening the visitor's email app.
VITE_QUOTE_ENDPOINT=
